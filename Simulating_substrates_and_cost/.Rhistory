0.9,          5.0,   # mostly closed, strong open penalty
0.6,          2.0,   # more open, modest open penalty
0.6,          5.0,   # more open, strong open penalty
0.2,          5.0    # mostly open, strong open penalty
)
# precompute cropped template matching your sim_fast.R logic
