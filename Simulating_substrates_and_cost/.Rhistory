# plot_examples.R
library(terra)
library(raster)
library(gdistance)
library(here)
library(sf)
library(ggplot2)
library(dplyr)
# Source your functions (fast sim + metrics)
source('/Users/jpaige/Desktop/Research repositories/simulating_energetics_diff_by_substrate/Simulating_substrates_and_cost/functions/functions_V4.R')
# -------------------------
# helper: safely run one sim
# -------------------------
run_one_example <- function(n, mod, cost0, cost1, c1_fraction,
c1_cluster_size, resource_cluster_size, r_template,
max_tries = 30) {
for (attempt in seq_len(max_tries)) {
out <- model_landscape_and_movement_fast(
grid_size = n,
mod = mod,
cost0 = cost0,
cost1 = cost1,
c1_fraction = c1_fraction,
c1_cluster_size = c1_cluster_size,
resource_cluster_size = resource_cluster_size,
raster_template = r_template
)
if (!is.null(out)) return(out)
}
return(NULL)
}
# -------------------------
# NOTE: This assumes your fast function returns:
# out[[1]] = cost_surface  (SpatRaster or RasterLayer)
# out[[2]] = lcp           (SpatVector or SpatialLines)
# out[[3]] = xy_start      (numeric length 2)   OR sometimes in a slot
# out[[4]] = xy_target     (numeric length 2)
# out[[5]] = substrate_r   (RasterLayer or SpatRaster)  (open/closed)
# out[[6]] = travel_cost_r (RasterLayer or SpatRaster)
#
# If your indexing differs, just change the extract lines below.
prep_plot_data <- function(out) {
cost_surface <- out[[1]]
lcp          <- out[[2]]
xy_start     <- out[[3]]
xy_target    <- out[[4]]
substrate_r  <- out[[5]]
travel_cost  <- out[[6]]
# normalize classes
if (inherits(cost_surface, "RasterLayer")) cost_surface <- rast(cost_surface)
if (inherits(substrate_r,  "RasterLayer")) substrate_r  <- rast(substrate_r)
if (inherits(travel_cost,  "RasterLayer")) travel_cost  <- rast(travel_cost)
if (inherits(lcp, "SpatialLines") || inherits(lcp, "SpatialLinesDataFrame")) {
lcp <- terra::vect(lcp)
}
# as data.frames for ggplot
df_sub <- as.data.frame(substrate_r, xy = TRUE, na.rm = FALSE)
names(df_sub)[3] <- "substrate"
df_tc <- as.data.frame(travel_cost, xy = TRUE, na.rm = FALSE)
names(df_tc)[3] <- "travel_cost"
df_cost <- as.data.frame(cost_surface, xy = TRUE, na.rm = FALSE)
names(df_cost)[3] <- "acc_cost"
# sf objects
lcp_sf <- st_as_sf(lcp)
start_sf <- st_as_sf(
data.frame(x = xy_start[1], y = xy_start[2]),
coords = c("x","y"),
crs = NA
)
target_sf <- st_as_sf(
data.frame(x = xy_target[1], y = xy_target[2]),
coords = c("x","y"),
crs = NA
)
list(
df_sub = df_sub,
df_tc = df_tc,
df_cost = df_cost,
lcp_sf = lcp_sf,
start_sf = start_sf,
target_sf = target_sf
)
}
# -------------------------
# helper: plot one example condition
# -------------------------
plot_example <- function(plot_dat, title_prefix = "") {
df_sub  <- plot_dat$df_sub
df_tc   <- plot_dat$df_tc
df_cost <- plot_dat$df_cost
lcp_sf    <- plot_dat$lcp_sf
start_sf  <- plot_dat$start_sf
target_sf <- plot_dat$target_sf
p_sub <- ggplot() +
geom_raster(data = df_sub, aes(x = x, y = y, fill = factor(substrate))) +
geom_sf(data = lcp_sf, color = "red", linewidth = 1.0) +
geom_sf(data = start_sf, fill = "dodgerblue", color = "black", shape = 21, size = 3) +
geom_sf(data = target_sf, fill = "gold", color = "black", shape = 21, size = 3) +
scale_fill_manual(values = c("0" = "gray85", "1" = "gray20"),
name = "Closed?",
labels = c("0 = open (cost2)", "1 = closed (cost1)")) +
coord_equal() +
theme_minimal() +
labs(title = paste0(title_prefix, "Substrate + LCP"),
x = NULL, y = NULL)
p_tc <- ggplot() +
geom_raster(data = df_tc, aes(x = x, y = y, fill = travel_cost)) +
geom_sf(data = lcp_sf, color = "red", linewidth = 1.0) +
geom_sf(data = start_sf, fill = "dodgerblue", color = "black", shape = 21, size = 3) +
geom_sf(data = target_sf, fill = "gold", color = "black", shape = 21, size = 3) +
scale_fill_viridis_c(name = "Travel cost") +
coord_equal() +
theme_minimal() +
labs(title = paste0(title_prefix, "Travel-cost raster + LCP"),
x = NULL, y = NULL)
p_cost <- ggplot() +
geom_raster(data = df_cost, aes(x = x, y = y, fill = acc_cost)) +
geom_sf(data = lcp_sf, color = "red", linewidth = 1.0) +
geom_sf(data = start_sf, fill = "dodgerblue", color = "black", shape = 21, size = 3) +
geom_sf(data = target_sf, fill = "gold", color = "black", shape = 21, size = 3) +
scale_fill_viridis_c(name = "Accum. cost") +
coord_equal() +
theme_minimal() +
labs(title = paste0(title_prefix, "Accumulated cost surface + LCP"),
x = NULL, y = NULL)
list(p_sub = p_sub, p_tc = p_tc, p_cost = p_cost)
}
# -------------------------
# main: pick a few conditions and save plots
# -------------------------
n <- 100
mod <- 5
c1_cluster_size <- 5
resource_cluster_size <- 5
# this is your baseline closed cost
cost0 <- 1
# EXAMPLES: choose a few combos you want to “show”
# c1_fraction = fraction CLOSED (cost0)
# so open fraction = 1 - c1_fraction (gets cost1)
examples <- tibble::tribble(
~c1_fraction, ~cost1,
0.9,          2.0,   # mostly closed, modest open penalty
0.9,          5.0,   # mostly closed, strong open penalty
0.6,          2.0,   # more open, modest open penalty
0.6,          5.0,   # more open, strong open penalty
0.2,          5.0    # mostly open, strong open penalty
)
# precompute cropped template matching your sim_fast.R logic
n_crop <- n - 2 * mod
r_template <- raster::raster(nrows = n_crop, ncols = n_crop,
xmn = mod, xmx = n - mod,
ymn = mod, ymx = n - mod)
r_template <- raster::setValues(r_template, rep(NA_real_, raster::ncell(r_template)))
# output folder
out_dir <- file.path(getwd(), "example_plots")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
set.seed(123)
for (j in seq_len(nrow(examples))) {
c1_frac <- examples$c1_fraction[j]
c_open_cost <- examples$cost1[j]
message(sprintf("Example %d/%d: c1_fraction=%.2f, cost1(open)=%.2f",
j, nrow(examples), c1_frac, c_open_cost))
out <- run_one_example(
n = n, mod = mod,
cost0 = cost0, cost1 = c_open_cost,
c1_fraction = c1_frac,
c1_cluster_size = c1_cluster_size,
resource_cluster_size = resource_cluster_size,
r_template = r_template,
max_tries = 50
)
if (is.null(out)) {
warning("Example failed after max tries; skipping.")
next
}
# metrics optional (nice to annotate filenames)
metrics <- tryCatch(
calculate_path_metrics(out[[1]], out[[2]],
substrate_r = out[[5]],
travel_cost_r = out[[6]]),
error = function(e) NULL
)
plot_dat <- prep_plot_data(out)
title_prefix <- sprintf("closed=%.2f (open=%.2f), open_cost=%.2f | ",
c1_frac, 1 - c1_frac, c_open_cost)
plots <- plot_example(plot_dat, title_prefix = title_prefix)
# save
tag <- sprintf("closed_%.2f_openCost_%.2f", c1_frac, c_open_cost)
tag <- gsub("\\.", "p", tag)  # safer filenames
ggsave(file.path(out_dir, paste0(tag, "_A_substrate.png")),
plots$p_sub, width = 7, height = 6, dpi = 300)
ggsave(file.path(out_dir, paste0(tag, "_B_travel_cost.png")),
plots$p_tc, width = 7, height = 6, dpi = 300)
ggsave(file.path(out_dir, paste0(tag, "_C_acc_cost.png")),
plots$p_cost, width = 7, height = 6, dpi = 300)
# optionally dump a one-line metrics file for quick reference
if (!is.null(metrics)) {
write.csv(metrics,
file.path(out_dir, paste0(tag, "_metrics.csv")),
row.names = FALSE)
}
}
